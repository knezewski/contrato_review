# Environment variable template. Copy to .env and fill in. .env is never committed.
# Values here are empty — never put real keys here.

# Generative LLM (Anthropic) — constitution V, spec §8
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Embeddings (local model; the token is needed only to download from Hugging Face)
HF_TOKEN=

# OCR fallback (optional; requires the system tesseract with the spa language)
OCR_ENABLED=false
